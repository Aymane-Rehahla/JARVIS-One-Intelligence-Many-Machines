      "title": "ToolUse",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "`jarvis.incubator-1.reply`: the end of a reply, always exactly one per request.\n\n`answered`: the language model's verified reply. `fallback`: a reply built from tool results with a fixed\ntemplate, because the model, a peer or a deadline failed (`reason` says which). `refused`: the request asked for\nsomething JARVIS does not do (it talks, it never acts). `error`: no answer could be given. An answered or\nfallback reply states the farm time its data comes from (ground rule 6), so `farm_time` and `label` are set.",
  "properties": {
    "chunks": {
      "minimum": 0,
      "title": "Chunks",
      "type": "integer"
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/Citation"
      },
      "maxItems": 10,
      "title": "Citations",
      "type": "array"
    },
    "confirm": {
      "anyOf": [
        {
          "$ref": "#/$defs/AckOffer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "conversation_id": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Conversation Id",
      "type": "string"
    },
    "farm_time": {
      "anyOf": [
        {
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Farm Time"
    },
    "label": {
      "anyOf": [
        {
          "enum": [
            "live: simulated brains",
            "live: trained brains"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Label"
    },
    "numbers_checked": {
      "minimum": 0,
      "title": "Numbers Checked",
      "type": "integer"
    },
    "outcome": {
      "enum": [
        "answered",
        "fallback",
        "refused",
        "error"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "reason": {
      "default": "",
      "maxLength": 300,
      "title": "Reason",
      "type": "string"
    },
    "request_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "text": {
      "maxLength": 8000,
      "title": "Text",
      "type": "string"
    },
    "timings": {
      "$ref": "#/$defs/ReplyTimings"
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/ToolUse"
      },
      "maxItems": 40,
      "title": "Tools",
      "type": "array"
    },
    "type": {
      "const": "chat_done",
      "default": "chat_done",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "conversation_id",
    "text",
    "chunks",
    "outcome",
    "numbers_checked",
    "timings"
  ],
  "title": "ChatDone",
  "type": "object"
}
