{
  "$comment": "Generated by tools/export_contracts.py from the pydantic model; do not edit.",
  "$defs": {
    "AckOffer": {
      "additionalProperties": false,
      "description": "The owner asked, in their own words, to acknowledge an alert: the website shows a confirm button for it. The\ntoken is single-use and expires (ConfirmTokens); only the owner's click sends it back (ground rule 3).",
      "properties": {
        "expires_utc": {
          "title": "Expires Utc",
          "type": "string"
        },
        "feed_id": {
          "pattern": "^[0-9a-f]{12}$",
          "title": "Feed Id",
          "type": "string"
        },
        "incident_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Incident Id",
          "type": "string"
        },
        "node": {
          "enum": [
            "incubator-1",
            "incubator-2",
            "hvac",
            "animal-protection"
          ],
          "title": "Node",
          "type": "string"
        },
        "summary": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "token": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Token",
          "type": "string"
        }
      },
      "required": [
        "node",
        "incident_id",
        "feed_id",
        "token",
        "expires_utc",
        "summary"
      ],
      "title": "AckOffer",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "description": "One approved document passage a reply used (from `search_documents` of that turn).",
      "properties": {
        "file": {
          "maxLength": 200,
          "minLength": 1,
          "title": "File",
          "type": "string"
        },
        "node": {
          "enum": [
            "incubator-1",
            "incubator-2",
            "hvac",
            "animal-protection"
          ],
          "title": "Node",
          "type": "string"
        },
        "section": {
          "maxLength": 200,
          "title": "Section",
          "type": "string"
        }
      },
      "required": [
        "node",
        "file",
        "section"
      ],
      "title": "Citation",
      "type": "object"
    },
    "ReplyTimings": {
      "additionalProperties": false,
      "description": "How long a reply took, measured by incubator-1 from the moment the question arrived (monotonic clock).",
      "properties": {
        "first_chunk_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Chunk Ms"
        },
        "llm_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Llm Ms"
        },
        "tools_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tools Ms"
        },
        "total_ms": {
          "minimum": 0,
          "title": "Total Ms",
          "type": "integer"
        }
      },
      "required": [
        "total_ms"
      ],
      "title": "ReplyTimings",
      "type": "object"
    },
    "ToolUse": {
      "additionalProperties": false,
      "description": "One tool call a reply made, with its own node, outcome and duration (the audit has the details).",
