# Keep exact bytes on every checkout: approval hashes (tools/knowledge.py) and the identical-copy checks depend on them.
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
# The read-only farm snapshot keeps its original bytes (some files use CRLF).
_dev/farm_poc_snapshot/** -text

# The installed release (decision 0015): stored byte for byte, as PROVENANCE.json records it
matrix/release_v31/** -text
